// probe.comp — P0.5: #include aus dem Klassenpfad, float16 und Untergruppen-Summe. Jeder Faden liest 1.0, rechnet über
// float16, verdoppelt und summiert über die Untergruppe: das Ergebnis ist 2 × die tatsächliche Untergruppengröße.
#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#include "/com/dan/hallighooge/p0/einbinden.glsl"
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Daten { float d[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    float16_t h = float16_t(d[i]);
    d[i] = subgroupAdd(verdoppeln(float(h)));
}
