# Seit P10b (12.11, F95 A): Kimmung. Am 18.10. um 08:00 UTC liegt kalte Luft (9 °C) über dem wärmeren Wasser (12 °C);
# die Kimm sinkt um rund 3 Bogenminuten, darüber steht das Spiegelbild der Ferne. Zu sehen ist das durch das Fernglas:
# Bildwinkel 5,6° senkrecht (10° waagerecht bei 16:9). Das Auge 4 m über NHN über dem tiefen Wasser westlich des
# Japsands, der Blick nach Nordwesten über freies Wasser auf den Kniepsand (6 km) und die Dünen im Süden von Amrum
# (8 bis 10 km, bis 20 m hoch); die Sonne steht im Rücken. Die Bildmitte liegt an der Kimm; dorthin rückt auch die
# feine Mitte des Geländes.
ansicht.fernglas.name           = Fernglas: über das Wasser nach Amrum
ansicht.fernglas.ort            = 462600 6046900
ansicht.fernglas.hoehe          = 4 nhn
ansicht.fernglas.richtung       = 325
ansicht.fernglas.neigung        = 0
ansicht.fernglas.bildwinkel     = 5.6

szenario.kimmung.name           = Kimmung, 18.10.2026 (kalte Luft über warmem Wasser)
szenario.kimmung.archiv         = ${daten}\_p9c\archiv_m1b
szenario.kimmung.beginn         = 2026-10-18T08:00:00Z
szenario.kimmung.zeitraffer     = 60
szenario.kimmung.ansicht        = fernglas
szenario.kimmung.schwebstoff    = 20

