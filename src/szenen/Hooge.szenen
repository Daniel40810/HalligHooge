schwimmer.hilligenlei.route     = Hooge.route_schluettsiel      # seit S7d: Weg ab dem Anleger (OSM, Schlüttsiel-Hooge)
schwimmer.hilligenlei.fahrplan  = tide -2:00 +1:30              # seit S7d2 (SF117 A): Ankunft 2 h vor, Abfahrt 1 h 30 nach dem Hochwasser am Pegel, bei Tag [G]

