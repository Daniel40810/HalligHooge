# ---------------------------------------------------------------- Kutschen

# Seit K3 (Werkbuch HalligHooge 181, F293–F299 A): drei Pferdebusse (Fuhrservice auf der Backenswarft, Remise am
# Kutscherhaus). Die Strecken rechnet das Steuerhaus aus OSM (--kutschen, kutschen.* in Hooge.steuerhaus) nach
# Hooge.kutschen; die App liest nur diese Datei. Zu jeder Ankunft der Fähren (Hilligenlei, Adler-Express) eine Runde,
# abfahrt min nach der Ankunft, zurück zurueck min vor der Abfahrt der Fähre; Saison in der Ortszeit (hooge.de, Adler:
# Kutschfahrt bis 31.10.) [G]. Gespanne: Bauart (lang, kurz) und die Felle links, rechts.
kutschen.datei      = Hooge.kutschen
kutschen.gespanne   = lang fuchs rotschimmel; lang brauner hellfuchs; kurz fuchs brauner
kutschen.faehren    = hilligenlei adler
kutschen.saison     = 04-01 10-31
kutschen.zone       = Europe/Berlin
kutschen.abfahrt    = 10
kutschen.zurueck    = 15

