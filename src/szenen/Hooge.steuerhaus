# Startseite und Atlas (X1, Werkbuch HalligHooge 145; F241 A, F243 A): die Startseite zeigt den Atlas, die Infotafeln und
# die Kacheln. Den Atlas rechnet einmal  ... --manifest src\szenen\Hooge.steuerhaus --atlas  (Gebiet und Archive auf D:);
# danach liest die Startseite nur noch src\szenen\atlas\ und die Texte in Hooge.atlas.
app.startseite = an
atlas.texte    = Hooge.atlas
atlas.karte    = 459500 6040000 475500 6052000
atlas.zelle    = 3
atlas.blick    = 469700 6046900 7500
atlas.ebene.1  = niedrig; Niedrigwasser; ruhig; niedrig
atlas.ebene.2  = hoch; Hochwasser; ruhig; hoch
atlas.ebene.3  = landunter; Landunter; sturm; scheitel
atlas.sturm    = sturm
atlas.ruhig    = ruhig

# Kapitel (X2, Werkbuch HalligHooge 146, F244 A): Regiebücher mit Tafeln und Haltepunkten; Startseite und Menü Regie › Kapitel.
kapitel.1 = kapitel/tag.kapitel
kapitel.2 = kapitel/landunter.kapitel
kapitel.3 = kapitel/xaver.kapitel
kapitel.4 = kapitel/stroemung.kapitel
kapitel.5 = kapitel/sediment.kapitel
kapitel.6 = kapitel/luft.kapitel

# Rundgänge (X3, Werkbuch HalligHooge 148, F240 A): Halte an Orten der Karte, dazwischen auf Augenhöhe die Wege entlang.
# Die Quellen schreibt man von Hand; die Wege rechnet einmal  ... --manifest src\szenen\Hooge.steuerhaus --wege
# (OSM-Wege und Gelände auf D:) nach rundgang\<name>.weg. Startseite (Gruppe „Rundgänge“) und Menü Regie › Rundgang.
rundgang.1 = rundgang/warften.rundgang
rundgang.2 = rundgang/landunter.rundgang

# Postkarte (X4, Werkbuch HalligHooge 150): Datei › Postkarte (Strg P) – der Blick jetzt mit Rahmen und Unterschrift.
# Vorlage = Name; Stil (gold, weiss, ohne); Titel; Zeile. Platzhalter: {titel} {ort} {ansicht} {szenario} {datum} {uhr}
# {pegel} {pegelname} {wind}; ein Teil zwischen „·“, dessen Platzhalter leer bleibt, fällt weg.
postkarte.titel     = Hallig Hooge
postkarte.vorlage.1 = Goldkante; gold; {titel}; {ort} · {datum}, {uhr} · {pegelname} {pegel} · Wind {wind}
postkarte.vorlage.2 = Gruß von der Hallig; weiss; Gruß von der {titel}; {ort} · {datum}, {uhr}
postkarte.vorlage.3 = Randlos; ohne; {ort}; {titel} · {datum}, {uhr} · Wind {wind}
postkarte.vorlage.4 = Landunter; gold; Landunter auf {titel}; {datum}, {uhr} · {pegelname} {pegel} · {ort}

# Vergleiche (Y1, Werkbuch HalligHooge 152; F246 B): zwei Szenarien, dieselbe Kamera, gleiche Phase der Tide – als
# Bildfolge der Ausgabe, im Spieler mit Schieber und den Kurven derselben Sonden. Menü Labor › Vergleich, Startseite
# (Gruppe „Vergleiche“). Beim ersten Öffnen rechnet die Ausgabe die Mappe nach ausgabe.vergleiche/<schluessel>.
vergleich.datei    = Hooge.vergleiche
ausgabe.vergleiche = docs/vergleich

# Ein Jahr in einer Minute (Y3, Werkbuch HalligHooge 154): der Boden der drei Läufe des Modelljahrs (P9c) als
# Differenzkarte im Zeitraffer, mit der Linie +1 m NHN des Japsands und einem Profil quer über den Sand bis Hooge.
# Menü Labor (Strg Umschalt J), Startseite (Gruppe „Labor“). Die Mappe rechnet einmal  ... --jahr  (Ausgabe; Archive
# und Gebiet auf D:), sonst beim ersten Öffnen. jahr.dauer: Sekunden je Abschnitt in der Minute (der Sturm langsamer).
jahr.name     = Ein Jahr in einer Minute
jahr.1        = morpho; Erstes Halbjahr
jahr.2        = morpho2; Zweites Halbjahr
jahr.3        = morphosturm; Sturm
jahr.dauer    = 24 24 12
jahr.sand     = Japsand
jahr.kasten   = 462000 6043000 468500 6051000
jahr.schwelle = 1.0
jahr.profil   = 462500 6046000 471500 6046000
jahr.ansicht  = japsand_oben
jahr.hinweis  = Modell, keine Messung: Drei Tage Wetter vom Oktober 2026 mit dem Boden mal 60 stehen für je ein halbes Jahr, der Sturm vom 25./26.10. mal 4 für fünf Tage (P9c). Das erste Halbjahr ist zum Teil Anpassung des Bodens an das Modell. Der Japsand wandert im Modell etwa halb so schnell nach Osten wie gemessen (6 statt 13 m im Jahr), fast ganz im Sturm; die Rinnen bewegen sich eher zu viel.
ausgabe.jahr  = docs/jahr

# Tidenkalender (Z1, Werkbuch HalligHooge 155; F248 B): Hoch- und Niedrigwasser je Tag, Spring- und Nipptide, Mond,
# Ausblick über acht Wochen. Auf Hooge gibt es keinen Pegel bei PEGELONLINE: die Konstanten kommen aus der Messung am
# Pegel Pellworm Anleger (gebiet/pegel), mit dem Modell auf den Anleger übertragen und an Wittdün geprüft. Einmal rechnen:
# ... --gezeiten (Ausgabe; Pegel, Gebiet und Archive auf D:) nach Hooge.gezeiten; danach liest die App nur diese Datei.
# Menü Begleiter › Tidenkalender (Strg Umschalt T), Startseite (Gruppe „Begleiter“).
gezeiten.name     = Tidenkalender
gezeiten.datei    = Hooge.gezeiten
gezeiten.ort      = Anleger Hooge; 471381 6047983; 300
gezeiten.bezug    = PELLWORM_ANLEGER; Pellworm Anleger; 500
gezeiten.pruef    = WITTDÜN; Wittdün (Amrum); 500
gezeiten.modell   = morpho, morpho2, ruhig
gezeiten.einschwingen = 24
gezeiten.stau     = 0.25
gezeiten.marke    = 2.01; Landunter (Sommerdeich)
# Seit DB5 (Werkbuch HalligHooge 176, F276–F282 A) wächst die Gezeit mit der Messung: Der Sammler rechnet am 1. jedes Monats
# (erster Abruf ab gezeiten.wachsen.uhr, Ortszeit) je Pegel einen Kandidaten aus allen Tagen im Messarchiv und prüft ihn an den
# jüngsten 30 Tagen; Hooge.gezeiten (und die Kopie im Abbild) ändert sich nur, wenn er besser ist. Von Hand: Sammler --gezeiten.
# gezeiten.wachsen = aus: nur von Hand.
gezeiten.wachsen  = an
gezeiten.wachsen.uhr = 3
gezeiten.kopie    = ../../dist/abbild/HalligHooge/app/szenen/Hooge.gezeiten
gezeiten.hinweis  = Astronomische Gezeit ohne Wind und Luftdruck: aus der Messung am Pegel Pellworm Anleger (PEGELONLINE, WSV), jeden Monat neu gerechnet und nur übernommen, wenn sie besser trifft (Knopf Herkunft), mit dem Modell auf den Anleger Hooge übertragen. Wind kann Hoch- und Niedrigwasser um Dezimeter, bei Sturm um Meter heben oder senken und verschieben. Nicht zur Navigation; amtlich ist der Gezeitenkalender des BSH.

# Landunter-Uhr (Z2, Werkbuch HalligHooge 156; F249, F250 A): das nächste Hochwasser mit Windstau – gemessen (PEGELONLINE,
# Mittel aus Pellworm Anleger und Wittdün, je Messung minus Gezeit der letzten Stunde; seit Z2b) oder gewählt – gegen zwei Höhen: die niedrigste Krone
# des Sommerdeichs (dort läuft Wasser über) und die Höhe außen, ab der im Modell die Fennen an den Warften nass werden
# (Landunter; in drei Stürmen frühestens 2,52 m). Dazu die Warften des Atlas beim Scheitel. Rechnet mit den Konstanten
# des Tidenkalenders (gezeiten.*; der Bezug und der Fehler des Windstaus stehen seit Z2 mit in Hooge.gezeiten).
# Menü Begleiter › Landunter-Uhr (Strg Umschalt U), Startseite (Gruppe „Begleiter“). LandunterCheck prüft an landunter.modell.
landunter.name    = Landunter-Uhr
landunter.krone   = 2.01; Krone des Sommerdeichs
landunter.nass    = 2.50; Fennen nass
landunter.modell  = seegang, xaver
landunter.hallig  = Hooge; 2500
landunter.sturm   = an
landunter.wahl.1  = 1.50; Sturmflut, BSH-Klasse
landunter.wahl.2  = 2.50; Schwere Sturmflut, BSH-Klasse
landunter.hinweis = Gezeit wie im Tidenkalender plus ein Windstau, der über die Tide gleich bleibt. Gemessen heißt: Mittel aus Messung minus Gezeit an den Pegeln Pellworm Anleger und Wittdün in der letzten Stunde (PEGELONLINE, WSV, ungeprüfte Rohdaten); Hooge liegt dazwischen, dort kann er anders sein, und er ändert sich mit dem Wind. Die BSH-Klassen gelten über dem mittleren Hochwasser, hier als Windstau. Landunter ab 2,50 m außen ist im Modell abgelesen (drei Stürme), nicht gemessen. Höhen der Warften aus dem Atlas (DGM1). Nicht zur Navigation und nicht zur Warnung: amtlich warnen das BSH und der LKN.SH.

# Watt-Fenster (Z3, Werkbuch HalligHooge 158): wann der Weg von der Westspitze zum Japsand trocken ist und wie lange.
# Einmal rechnen: ... --watt (Ausgabe; Gelände und Archive auf D:, dazu Hooge.gezeiten) nach Hooge.watt und watt/;
# danach liest die App nur diese Dateien. Menü Begleiter › Watt-Fenster (Strg Umschalt W), Startseite (Gruppe „Begleiter“).
watt.name    = Watt-Fenster
watt.datei   = Hooge.watt
watt.start   = Westspitze; 468290 6047690
watt.ziel    = Japsand; 465987 6046653; 300
watt.karte   = 463000 6044000 470000 6050000; 5
watt.priel   = 120
watt.modell  = morpho, morpho2, ruhig
watt.gehen   = 3
watt.hinweis = Modell, nicht zur Navigation. Trocken heißt hier: Der höchste Weg im Gelände (DGM1, TrilaWatt 2021) liegt über dem Wasser; wann das Watt leerläuft und wieder vollläuft, kommt aus dem Modell, die Gezeit aus dem Tidenkalender (ohne Wind; Wind kann das Fenster verschieben, kürzen oder schließen). Priele verlagern sich, Nebel und Schlick sind nicht enthalten. Ins Watt zum Japsand nur mit Nationalpark-Wattführerin oder -Wattführer.

# Messarchiv (DB1, Werkbuch HalligHooge 167; F261–F265 A): ein Sammler ohne Fenster (com.dan.steuerhaus.messung.Sammler)
# holt stündlich den Wasserstand der Pegel von PEGELONLINE und täglich den Wind des DWD in das Oracle-Schema HALLIGHOOGE
# (Präfix HH_, Lage in ETRS89 / UTM 32), verdichtet auf 10 Minuten, sucht Hoch- und Niedrigwasser und schätzt das
# Hochwasser am Anleger Hooge (Gezeit aus gezeiten.datei plus Windstau der Bezugspegel, Schwellen aus landunter.krone und
# landunter.nass). Die App braucht die Datenbank nicht. Wachstumsgrenze: Minutenwerte in Monatsfächern, nach
# messung.roh.monate weg (ihre Mittel bleiben); über messung.grenze.mb fallen die ältesten Fächer, reicht das nicht, fügt
# der Sammler nichts mehr ein. Einrichten: tools\lauf_DB1.cmd; die stündliche Aufgabe: tools\sammler_aufgabe.cmd.
messung.name        = Messarchiv
messung.db          = ../../db/db.properties
messung.sql         = ../../db/sql
messung.schema      = HALLIGHOOGE
messung.praefix     = HH_
messung.passwort    = HalligHooge_DB_PASSWORD
messung.srid        = 25832
messung.roh.monate  = 6
messung.abruf.tage  = 400
messung.grenze.mb   = 1500
messung.warnung     = 80
messung.pegelonline = https://www.pegelonline.wsv.de/webservices/rest-api/v2
messung.dwd         = https://opendata.dwd.de/climate_environment/CDC/observations_germany/climate/10_minutes/wind/recent
messung.dwd.stunden = 20
messung.ort         = HOOGE_ANLEGER; Anleger Hooge

# Chronik der Hochwasser (DB2, Werkbuch HalligHooge 169; F266 A, F267 A): der Sammler des Messarchivs schreibt Hooge.chronik
# neben dieses Manifest (und in die Kopie im Abbild, wenn es das gibt), aber nur, wenn ein Ereignis dazukommt oder sich
# ändert. Die App liest nur die Datei: Menü Labor › Chronik der Hochwasser (Strg Umschalt H), Startseite (Gruppe „Labor“),
# dazu unter der Landunter-Uhr „Zuletzt Landunter …“ und der gemessene Windstau des jüngsten Landunters zur Auswahl.
# Der Knopf eines Ereignisses öffnet das erste Szenario, dessen Archiv die Zeit abdeckt (eine Stunde vor dem höchsten
# Wasser), am Ort mit chronik.ansicht.
chronik.name    = Chronik der Hochwasser
chronik.datei   = Hooge.chronik
chronik.kopie   = ../../dist/abbild/HalligHooge/app/szenen/Hooge.chronik
chronik.ansicht = landunter_hanswarft
chronik.hinweis = Landunter und Wasser über der Krone am Anleger Hooge sind geschätzt: Gezeit aus dem Tidenkalender plus Windstau an Pellworm Anleger und Wittdün (PEGELONLINE, WSV, ungeprüfte Rohdaten); Landunter ab 2,50 m außen ist im Modell abgelesen. Sturmfluten nach den Klassen des BSH über dem mittleren Hochwasser (MThw) der Pegel. Nicht amtlich: amtlich warnen das BSH und der LKN.SH.

# Modell gegen Messung (DB3, Werkbuch HalligHooge 171; F268–F271 A): wie gut das Modell die Pegel trifft. Die Ausgabe
# (Ausgabe --guete) liest aus jedem Archiv der Szenarien den Wasserstand an den Pegeln guete.pegel (tiefste Zelle im
# Umkreis guete.umkreis auf dem feinsten Gitter, das den Pegel enthält; erst nach guete.einschwingen Stunden) nach
# guete.modell (bleibt lokal bei den Daten). Der Sammler (Sammler --guete) legt die Reihen ins Messarchiv (HH_LAUF,
# HH_MODELL, HH_MODELL_SCHEITEL), stellt sie neben die Messung (HH_VERGLEICH_V, HH_SCHEITEL_PAAR_V), rechnet die
# Kennzahlen (HH_GUETE) und schreibt guete.datei neben dieses Manifest (und in die Kopie im Abbild), nur bei Änderung.
# Die App liest nur die Datei: Menü Labor › Modell gegen Messung (Strg Umschalt M), Startseite (Gruppe „Labor“).
# guete.stau: Hochwasser mit mindestens so viel gemessenem Windstau (m) zählen für den Anteil des Windstaus im Modell.
guete.name         = Modell gegen Messung
guete.pegel        = PELLWORM_ANLEGER; WITTDÜN; HÖRNUM; DAGEBÜLL; HUSUM; LIST_AUF_SYLT; EIDER-SPERRWERK_AP
guete.umkreis      = 500
guete.einschwingen = 24
guete.stau         = 0.5
guete.modell       = ../../daten/guete/Hooge.modell
guete.datei        = Hooge.guete
guete.kopie        = ../../dist/abbild/HalligHooge/app/szenen/Hooge.guete
guete.ansicht      =
# seit DB4 (Werkbuch HalligHooge 173; F272–F275 A): der Wind des Modells (ERA5 im Archiv) an den Windstationen des DWD
# (Kennung; Lage aus daten/gebiet/wind/wind.txt) gegen die Messung, auf 10 m; der Faktor zählt ab guete.wind.min m/s, „Sturm“
# ab guete.wind.sturm m/s gemessen. Mittelwasser: gemessenes Mittel über guete.mittelwasser.tage Tage um die Mitte des Laufs.
guete.wind         = 03032; 02115
guete.wind.min     = 5
guete.wind.sturm   = 15
guete.mittelwasser.tage = 30
guete.hinweis      = Modell: Wasserstand der App an der Zelle mit dem tiefsten Grund im Umkreis von 500 m um den Pegel (Gitter G2, 200 m). Messung: PEGELONLINE (WSV, ungeprüfte Rohdaten), Mittel über 10 Minuten; Hoch- und Niedrigwasser aus der Scheitelsuche des Messarchivs. Bias und Versatz: Modell minus Messung. Skill nach Willmott (1 = deckungsgleich). Windstau im Modell: Hochwasser des Modells minus die Gezeit am Pegel. Xaver (Dezember 2013): nur das höchste Tidehochwasser (HThw) der Kennwerte von PEGELONLINE, ohne Reihe. Mittelwasser: Mittel der Messung über 30 Tage um den Lauf; das Modell rechnet mit dem Mittel aus seinem Antrieb (0,0 m). Wind: ERA5 im Modell (10 m) gegen den DWD (List, Helgoland; Geber 10 m); Faktor = Mittel Modell / Messung ab 5 m/s, der Windschub wächst mit seinem Quadrat.
