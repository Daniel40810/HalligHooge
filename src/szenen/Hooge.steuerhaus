# HalligHooge – Manifest im Steuerhaus (Werkbuch HalligHooge 110, F178 A)
# Format wie Rezept und Szenendatei: schluessel = wert, # leitet einen Kommentar ein.

app.titel          = HalligHooge
app.unterzeile     = Gezeiten, Priele und Landunter um die Hallig
app.version        = 2.7
app.logo           = HARBOR
app.icon           = HalligHooge.png
app.szenen         = Hooge.szenen
app.thema          = nautik
app.arbeitsbereich = steuern
app.fotos          = docs/fotos
# seit W4: Ablage der Videos und Stärke des Filmkorns in Video und Standbild (1 = Vision3 250D, 0 = aus; seit W4b 0,5, F207 A)
ausgabe.videos     = docs/video
ausgabe.korn       = 0.5
app.zone           = Europe/Berlin

# Einblendungen (W2, Werkbuch HalligHooge 113): die Minikarte über Hooge und den Japsand (UTM 32: Ost, Nord, Ost, Nord),
# die Ortsnamen aus OpenStreetMap (tools/orte/orte.py schreibt orte.txt in den Ordner des Gebiets; F187 A).
# Weitere Schlüssel: orte.ohne = Name, Name · orte.umbenennen = Alt > Neu; … · orte.dazu.1 = Art; Name; Ost; Nord · einblendung.mass = 1.25
